# VulnPrioritizer Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Keys
# =============================================================================

# Gemini API Key (Required for AI chatbot)
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# NVD API Key (Optional but recommended for faster data pulls)
# Request at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# =============================================================================
# Application Settings
# =============================================================================

# Debug mode (set to false in production)
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/vulnprioritizer.db

# =============================================================================
# ML Model Settings
# =============================================================================

# Path to trained model
MODEL_PATH=./models/rf_classifier.joblib

# Minimum F1 score threshold for model deployment
MIN_F1_SCORE=0.92

# =============================================================================
# CORS Settings (Frontend URLs)
# =============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
